{
  "name": "truemotion",
  "version": "0.3.0",
  "description": "Open, harness-agnostic motion-graphics scene tool, MCP server and renderer",
  "type": "module",
  "license": "MIT",
  "author": "TrueMotion contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instax-dutta/truemotion.git"
  },
  "homepage": "https://github.com/instax-dutta/truemotion#readme",
  "bugs": "https://github.com/instax-dutta/truemotion/issues",
  "keywords": [
    "mcp",
    "motion-graphics",
    "video",
    "gsap",
    "playwright",
    "ffmpeg",
    "agents"
  ],
  "bin": {
    "truemotion": "./bin/truemotion.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skill/",
    "test/",
    "examples/",
    "scripts/",
    "docs/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CONTRIBUTING.md",
    "!examples/out/",
    "!examples/pro-out/",
    "!examples/**/*.mp4",
    "!examples/**/*.m4a",
    "!examples/**/*.wav"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo": "node examples/intro-demo.mjs",
    "demo:pro": "node examples/pro-demo.mjs",
    "selftest": "node bin/truemotion.mjs selftest",
    "benchmark": "node scripts/benchmark.mjs",
    "bench:longform": "node scripts/longform-benchmark.mjs",
    "bench:av": "node scripts/av-benchmark.mjs",
    "goldens": "node scripts/generate-goldens.mjs",
    "test:e2e": "TRUEMOTION_E2E=1 node --test test/combined-e2e.test.js",
    "test:crash": "TRUEMOTION_CRASH=1 node --test test/crash-resume.test.js",
    "test:audio-resume": "TRUEMOTION_AUDIO_RESUME=1 node --test test/audio-resume.test.js",
    "test:csp": "TRUEMOTION_CSP=1 node --test test/csp.test.js",
    "test:mcp-schema": "TRUEMOTION_MCP_SCHEMA=1 node --test test/mcp-schema-skill.test.js",
    "test:long-av": "TRUEMOTION_LONG_AV=1 node --test test/long-av-resume.test.js",
    "test:scene-order": "TRUEMOTION_SCENE_ORDER=1 node --test test/scene-order-resume.test.js",
    "test:settings-resume": "TRUEMOTION_SETTINGS_RESUME=1 node --test test/settings-resume.test.js",
    "test:component-resume": "TRUEMOTION_COMPONENT_RESUME=1 node --test test/component-resume.test.js",
    "test:concurrent": "TRUEMOTION_CONCURRENT=1 node --test test/concurrent-mcp.test.js",
    "test:contention": "TRUEMOTION_CONTENTION=1 node --test test/contention-stress.test.js",
    "check": "node --test test/*.test.js && npm pack --dry-run"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gsap": "^3.15.0",
    "playwright-core": "^1.61.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  }
}
