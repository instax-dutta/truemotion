y:1,duration:.6,ease:'power3.out'},2.35);\ntl.fromTo('[data-om-id=\"r3\"]',{x:-26,opacity:0},{x:0,opacity:1,duration:.6,ease:'power3.out'},2.95);\ntl.fromTo('.note',{opacity:0},{opacity:1,duration:.5},3.5);\nwindow.__SCENE_TIMELINE__=tl;\nwindow.__SCENE_DURATION__=5;\n</script></body></html>"
